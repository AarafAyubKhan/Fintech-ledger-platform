# ============================================
# FinSight AI — .gitignore
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.Python

# ---------- Node.js ----------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ---------- Environment ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Testing ----------
coverage/
htmlcov/
.coverage
.pytest_cache/
.nyc_output/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Build artifacts ----------
*.pyc
*.pyo
*.pyd
*.dll
*.dylib

# ---------- Data ----------
data/uploads/*
!data/uploads/.gitkeep
data/sample/*
!data/sample/.gitkeep

# ---------- Secrets ----------
*.pem
*.key
*.cert
secrets/
